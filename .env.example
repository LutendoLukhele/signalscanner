PORT=3000

# Reddit — no key needed, public JSON API
REDDIT_DELAY_MS=1500

# Nitter instances for Twitter/X (comma-separated, rotated)
NITTER_INSTANCES=nitter.net,nitter.privacydev.net,nitter.poast.org

# Ollama (optional — for richer scoring)
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cron schedule (default: 8am daily)
CRON_SCHEDULE=0 8 * * *
